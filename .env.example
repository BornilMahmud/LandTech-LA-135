# LandWise AI Environment Configuration
# Note: The platform operates offline or online.

# CARTO API Key for authenticated basemap tile access (Voyager, Positron, Dark Matter)
VITE_CARTO_API_KEY=your_carto_api_key_here

# Optional: Google Gemini API Key for generative contextual synthesis (offline deterministic engine used if omitted)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Dev Server Port
PORT=3000
BACKEND_PORT=8000

